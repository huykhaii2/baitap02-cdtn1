# Sao chép thành .env rồi sửa giá trị:  cp .env.example .env   (Windows: copy .env.example .env)
# KHÔNG commit .env – file này đã nằm trong .gitignore.

# Cơ sở dữ liệu PostgreSQL 16 (khớp README mục 3, bước 4–5).
# Chạy bằng Docker: giữ nguyên các giá trị này – docker compose tự đặt DB_HOST=db
# và dùng DB_NAME / DB_USER / DB_PASSWORD để tạo CSDL lần đầu.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartcrm
DB_USER=smartcrm
DB_PASSWORD=smartcrm
# Dùng CSDL trên mây (Supabase…) thì thay 5 dòng trên bằng chuỗi kết nối và bật SSL:
# DATABASE_URL=postgres://user:mat-khau@host:5432/postgres
# DB_SSL=true

# Ứng dụng
# Cổng mở ra máy (Docker) hoặc cổng chạy npm start
APP_PORT=3000
# Khoá ký token đăng nhập, >= 32 ký tự. Sinh khoá thật bằng: openssl rand -hex 32
SECRET_KEY=thay-bang-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
TOKEN_EXPIRES_IN=8h
